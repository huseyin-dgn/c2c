# Public canonical URL; leave empty until the real domain is known.
NEXT_PUBLIC_SITE_URL=
# Delivery is disabled until every required setting is configured.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
# Set only after the approved privacy notice is added to /kvkk.
CONTACT_PRIVACY_APPROVED=false
CONTACT_PRIVACY_VERSION=
# Upstash-compatible Redis REST endpoint. Required for distributed rate limiting.
RATE_LIMIT_REST_URL=
RATE_LIMIT_REST_TOKEN=
# Trust this header ONLY when your reverse proxy overwrites it with the client IP.
CONTACT_IP_HEADER=
